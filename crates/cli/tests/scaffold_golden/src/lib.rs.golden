//! demo_flow — a minimal Web flow scaffolded by `flows new` (tier a).
//!
//! Shape mirrors `examples/s1_echo`, the canonical minimal Web flow.
//! Authoring conventions (effects, determinism, topology, route metadata,
//! verification tiers) live in:
//!   impl-docs/spec/example-authoring-conventions.md
//!   impl-docs/spec/node-vs-capability-surface.md
//!
//! Replace the placeholder logic below with the real workflow. Keep the major
//! workflow stages graph-visible and keep the node boundaries truthful about
//! `effects` / `determinism`.

use dag_core::NodeResult;
use dag_macros::{def_node, node};
use serde::{Deserialize, Serialize};

/// Trigger input. This is the shape `payloads/sample.json` must match.
#[derive(Clone, Debug, Serialize, Deserialize)]
pub struct DemoFlowRequest {
    pub value: String,
}

/// Responder output returned to the HTTP caller.
#[derive(Clone, Debug, Serialize, Deserialize)]
pub struct DemoFlowResponse {
    pub value: String,
}

// HTTP ingress trigger. A trigger node is the entrypoint of a Web flow; it is
// `Pure` here because it only forwards the parsed request. See
// impl-docs/spec/example-authoring-conventions.md ("Keep major semantics visible").
#[def_node(
    trigger,
    name = "HttpTrigger",
    summary = "Ingress HTTP trigger for the demo_flow route",
    effects = "Pure",
    determinism = "Strict"
)]
async fn http_trigger(request: DemoFlowRequest) -> NodeResult<DemoFlowRequest> {
    Ok(request)
}

// One Pure transformation node. Put real, deterministic business logic here.
// If this node needs a capability (kv/blob/http/...), declare it via
// `resources(...)` so the requirement stays verifiable — see
// impl-docs/spec/node-vs-capability-surface.md.
#[def_node(
    name = "Process",
    summary = "Transform the demo_flow payload",
    effects = "Pure",
    determinism = "Strict"
)]
async fn process(input: DemoFlowRequest) -> NodeResult<DemoFlowResponse> {
    Ok(DemoFlowResponse {
        value: input.value.trim().to_string(),
    })
}

// Responder node: finalize the HTTP response. Kept as a distinct, graph-visible
// capture boundary (see "Preserve route metadata" in the conventions doc).
#[def_node(
    name = "Responder",
    summary = "Finalize the demo_flow HTTP response",
    effects = "Pure",
    determinism = "Strict"
)]
async fn responder(payload: DemoFlowResponse) -> NodeResult<DemoFlowResponse> {
    Ok(payload)
}

dag_macros::flow! {
    name: demo_flow_flow,
    version: "1.0.0",
    profile: Web,
    summary: "Scaffolded demo_flow Web flow";
    let trigger = node!(http_trigger);
    let process = node!(process);
    let responder = node!(responder);
    connect!(trigger -> process);
    connect!(process -> responder);
    entrypoint!({
        trigger: "trigger",
        capture: "responder",
        route_aliases: ["/demo-flow"],
        method: "POST",
        deadline_ms: 250,
    });
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn flow_contains_expected_nodes() {
        let ir = flow();
        let aliases: Vec<_> = ir.nodes.iter().map(|node| node.alias.as_str()).collect();
        assert_eq!(aliases, vec!["trigger", "process", "responder"]);
        assert_eq!(ir.edges.len(), 2);
    }
}
