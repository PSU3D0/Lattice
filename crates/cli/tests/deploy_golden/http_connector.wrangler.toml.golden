# wrangler.toml — rendered by `flows deploy render` (infra-from-code v0).
#
# flow: http_longtail_demo_flow v1.0.0 (id 00000000-0000-5000-8000-0000000000f0)
# requirements schema: 0.2
#
# Review every REPLACE_WITH_* placeholder before `wrangler deploy`; each carries
# a comment with the exact `wrangler` command that creates the resource.

name = "http-longtail-demo-flow"
main = "build/worker/shim.mjs"
workers_dev = true
compatibility_date = "2024-09-23"

[build]
# worker-build install handled once by the guard script (see README "Workers build tooling").
command = "bash \"$(git rev-parse --show-toplevel)/scripts/ensure-worker-build.sh\" --release"

# HTTP entrypoints (served by the worker fetch handler, not wrangler config;
# workers_dev = true exposes the <name>.workers.dev route):
#   POST /run  (trigger `trigger` -> capture `capture`)

# Size budget (Cloudflare Workers free tier): warn > 900 KiB compressed, error > 1 MiB.
# No wasm artifact was available at render time, so the compressed module size was NOT checked.
# After building, re-render with: --wasm-artifact target/wasm32-unknown-unknown/release/<package>.wasm

# NOTES:
# - connector op `connector.http.get` requires a bound connection (endpoint_profile `http_target` expects endpoint.profile; outbound_auth `http_target_auth` expects http.bearer); bind instances in bindings.lock and provide secrets via `wrangler secret put` before activation
# - connector op `connector.http.post` requires a bound connection (endpoint_profile `http_target` expects endpoint.profile; outbound_auth `http_target_auth` expects http.bearer); bind instances in bindings.lock and provide secrets via `wrangler secret put` before activation
# - connector op `connector.http.get_any_origin` requires a bound connection (endpoint_profile `http_anywhere` expects endpoint.any_origin); bind instances in bindings.lock and provide secrets via `wrangler secret put` before activation
# - connector.http origin-audit: node `fetch_crm` (connection `crm_api`) -> origin https://api.crm.example
# - connector.http origin-audit: node `fetch_public` (connection `anywhere`) -> ANY-ORIGIN (Tier 2, unauthenticated)
# - connector.http origin-audit: node `push_stats` (connection `crm_api`) -> origin https://api.crm.example
# - connector.http Tier-2 (any-origin) grant present — node(s) fetch_public can reach ANY origin with NO platform-managed credential (spec §8/§10); review before `wrangler deploy`
# - no wasm artifact available at render time; module size budget NOT checked (see the size budget comment in wrangler.toml)
# - worker entry crate is not scaffolded by this command yet; follow the crates/host-workers worker-build entry pattern (see its wrangler.toml and scripts/ensure-worker-build.sh)
