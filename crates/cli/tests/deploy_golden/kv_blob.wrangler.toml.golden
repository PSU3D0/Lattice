# wrangler.toml — rendered by `flows deploy render` (infra-from-code v0).
#
# flow: kv_blob_demo_flow v1.0.0 (id 00000000-0000-5000-8000-000000000001)
# requirements schema: 0.2
#
# Review every REPLACE_WITH_* placeholder before `wrangler deploy`; each carries
# a comment with the exact `wrangler` command that creates the resource.

name = "kv-blob-demo-flow"
main = "build/worker/shim.mjs"
workers_dev = true
compatibility_date = "2024-09-23"

[build]
# worker-build install handled once by the guard script (see README "Workers build tooling").
command = "bash \"$(git rev-parse --show-toplevel)/scripts/ensure-worker-build.sh\" --release"

# resource::kv — required by node(s): cache_read, cache_write
# create with: wrangler kv namespace create kv-blob-demo-flow-kv
[[kv_namespaces]]
binding = "FLOW_KV"
id = "REPLACE_WITH_KV_NAMESPACE_ID"

# resource::blob — required by node(s): store
# create with: wrangler r2 bucket create kv-blob-demo-flow-blob
[[r2_buckets]]
binding = "BLOB_BUCKET"
bucket_name = "kv-blob-demo-flow-blob"

# durability: checkpoint store (durability.mode = "partial") — host-workers Durable Object idiom
[[durable_objects.bindings]]
name = "FLOW_DO"
class_name = "FlowDurableObject"

[[migrations]]
tag = "v1"
new_sqlite_classes = ["FlowDurableObject"]

# HTTP entrypoints (served by the worker fetch handler, not wrangler config;
# workers_dev = true exposes the <name>.workers.dev route):
#   POST /demo  (trigger `trigger` -> capture `capture`)

# Size budget (Cloudflare Workers free tier): warn > 900 KiB compressed, error > 1 MiB.
# No wasm artifact was available at render time, so the compressed module size was NOT checked.
# After building, re-render with: --wasm-artifact target/wasm32-unknown-unknown/release/<package>.wasm

# NOTES:
# - resource::blob maps to R2 per the W1 mapping table, but no cap-blob-workers provider crate exists yet; the binding is rendered for the planner, runtime wiring is a follow-up
# - trigger `poller` is wired to neither an HTTP nor a schedule entrypoint (kind = unspecified) — the worker will NOT fire it
# - no wasm artifact available at render time; module size budget NOT checked (see the size budget comment in wrangler.toml)
# - worker entry crate is not scaffolded by this command yet; follow the crates/host-workers worker-build entry pattern (see its wrangler.toml and scripts/ensure-worker-build.sh)
